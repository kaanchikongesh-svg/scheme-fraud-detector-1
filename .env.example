# ─── GovKavach AI Cloud Environment Configuration ───────────────────────────
# Copy this file to `backend/.env` or `.env` and configure your credentials.
# The backend reads these via pydantic-settings in backend/config.py.

# ─── Database Configuration (PostgreSQL / SQLite) ───────────────────────────
DATABASE_URL=postgresql://govkavach:your_password@your-db-host:5432/leakage_db

# ─── MongoDB Atlas Configuration (Production Cloud NoSQL) ────────────────────
MONGODB_ENABLED=true
MONGODB_DUAL_WRITE=true
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=government_scheme_leakage
MONGODB_CONNECT_TIMEOUT_MS=2000

# ─── Security & JWT Authentication ──────────────────────────────────────────
# JWT signing secret — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=govkavach-ai-secret-key-CHANGE-IN-PRODUCTION-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Frontend & Cross-Origin Settings ───────────────────────────────────────
# The production URL of the deployed frontend web application (e.g. Vercel)
FRONTEND_URL=https://govkavach-ai.vercel.app
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_SECONDS=60

# ─── Real SMTP Email Configuration (Gmail / Outlook / AWS SES / SendGrid) ────
# For Gmail:
#   1. Set SMTP_HOST=smtp.gmail.com
#   2. Set SMTP_PORT=587
#   3. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
#   4. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#   5. Paste the App Password into SMTP_PASSWORD (do not use your regular Gmail password)
#   6. Set SMTP_USERNAME and SMTP_FROM_EMAIL to your full Gmail address
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="GovKavach AI — Scheme Leakage Detector"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ─── Seeding Configuration ───────────────────────────────────────────────────
SEED_COUNT=500
