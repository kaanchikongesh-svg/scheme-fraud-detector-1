# ─── Verdant Shield Environment Configuration ────────────────────────────────
# Copy this file to `backend/.env` or `.env` and configure your credentials.
# The backend reads these via pydantic-settings in backend/config.py.

# ─── Database Configuration ──────────────────────────────────────────────────
# Primary database: PostgreSQL in production, or SQLite fallback (sqlite:///leakage.db)
DATABASE_URL=postgresql://verdant:verdant_pass@localhost:5432/leakage_db

# ─── Security & JWT ──────────────────────────────────────────────────────────
# JWT signing secret — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=verdant-shield-secret-key-CHANGE-IN-PRODUCTION-2024
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Frontend & Password Reset Settings ──────────────────────────────────────
# The base URL of the frontend web application for generating real reset links
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_SECONDS=60

# ─── Real SMTP Email Configuration (Gmail / Outlook / AWS SES) ───────────────
# For Gmail:
#   1. Set SMTP_HOST=smtp.gmail.com
#   2. Set SMTP_PORT=587
#   3. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
#   4. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#   5. Paste the App Password into SMTP_PASSWORD (do not use your regular Gmail password)
#   6. Set SMTP_USERNAME and SMTP_FROM_EMAIL to your full Gmail address
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="Verdant Shield — AI Leakage Detector"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ─── Seeding Configuration ───────────────────────────────────────────────────
SEED_COUNT=500

# ─── MongoDB Atlas Sidecar (Optional) ────────────────────────────────────────
MONGODB_ENABLED=false
MONGODB_DUAL_WRITE=false
MONGODB_URI=
MONGODB_DATABASE=government_scheme_leakage
MONGODB_CONNECT_TIMEOUT_MS=1500
