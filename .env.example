# SchemeSecure AI Environment Configuration Template

# ─────────────────────────────────────────────────────────────
# 1. Primary Database: PostgreSQL (Authoritative SQL Store)
# ─────────────────────────────────────────────────────────────
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://verdant:verdant_pass@localhost:5432/leakage_db
POSTGRES_URL=postgresql://verdant:verdant_pass@localhost:5432/leakage_db

# ─────────────────────────────────────────────────────────────
# 2. Local Fallback Database: SQLite (Zero-downtime development)
# ─────────────────────────────────────────────────────────────
SQLITE_URL=sqlite:///backend/leakage.db

# ─────────────────────────────────────────────────────────────
# 3. Security & Authentication
# ─────────────────────────────────────────────────────────────
SECRET_KEY=your-secure-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─────────────────────────────────────────────────────────────
# 4. Frontend & CORS
# ─────────────────────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:8080","http://localhost:8080","http://127.0.0.1:8000","http://localhost:8000"]

# ─────────────────────────────────────────────────────────────
# 5. Application Seeding
# ─────────────────────────────────────────────────────────────
SEED_COUNT=500


# SMTP / Email Alerts (Optional - server starts normally without it)
# For Port 587 (Standard TLS / STARTTLS - e.g., Gmail with App Password, SendGrid, Mailgun):
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@schemesecure.ai
SMTP_FROM_NAME="SchemeSecure AI — AI Government Scheme Fraud Detection & Verification System"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# For Port 465 (Direct SSL):
# SMTP_PORT=465
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true

