# SchemeSecure AI Environment Configuration Template

# Database Configuration (PostgreSQL or local SQLite fallback)
DATABASE_URL=postgresql://verdant:verdant_pass@localhost:5432/leakage_db

# Security & JWT
SECRET_KEY=your-secure-secret-key-here
JWT_SECRET=your-secure-jwt-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─────────────────────────────────────────────────────────────
# Frontend API Base URL (Vite Environment Variables)
# Local development:  http://127.0.0.1:8000
# Production:         https://<your-deployed-backend-domain> (e.g., https://schemesecure-backend.onrender.com)
# ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# CORS & Frontend URLs
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:3000","http://localhost:3000","https://schemesecure-ai.vercel.app"]

# Seeding & AI
SEED_COUNT=500
AI_API_KEY=

# MongoDB Atlas (Optional Dual-Write)
MONGODB_URI=
MONGODB_DATABASE=government_scheme_leakage
MONGODB_ENABLED=false

# SMTP / Email Alerts (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@schemesecure.ai
